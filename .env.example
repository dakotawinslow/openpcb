# Django
# dev:  any value works (the default django-insecure-... key is fine)
# prod: generate a real key, e.g. `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
# dev:  localhost,127.0.0.1
# prod: add the domain the site is served on, e.g. alpha.openpcb.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# prod only: comma-separated origins (with scheme) allowed to POST. Required
# behind an HTTPS proxy or login/signup/upload forms 403. Leave empty in dev.
# e.g. https://alpha.openpcb.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# prod: set to True once the site is served over HTTPS — enables SSL
# redirect, secure cookies, and HSTS. Leave unset/False for local dev.
DJANGO_SSL=False

# Docker
# Host port the web container is published on (container always listens on
# 8000 internally). Override per environment as needed.
WEB_PORT=8000

# Postgres
POSTGRES_DB=openpcb
POSTGRES_USER=openpcb
POSTGRES_PASSWORD=localdevpassword
DATABASE_URL=postgres://openpcb:localdevpassword@db:5432/openpcb

# Cloudflare R2
# Create a bucket at dash.cloudflare.com → R2, then generate an API token
# with Object Read & Write on that bucket.
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=openpcb-files
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Email
# dev:  django.core.mail.backends.console.EmailBackend  (prints to terminal)
# prod: configure Resend or another SMTP provider
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
